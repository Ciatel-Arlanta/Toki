{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toki",
  "version": "0.4.0",
  "identifier": "dev.achintya.toki",
  "build": {
    "beforeDevCommand": "bun --cwd=../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../../scripts/prebuild-gui.ps1",
    "frontendDist": "ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "Toki",
        "visible": false,
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/toki-daemon"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
